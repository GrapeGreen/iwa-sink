{
  "id": "/",
  "name": "IWA Sink",
  "short_name": "IWA Sink",
  "description": "IWA Sink: Direct Sockets TCP, Controlled Frame, Loopback PKCE SSO, Sub-Apps, Desktop Windowing, ChromeOS Screen Capture, and Extension Connectivity.",
  "version": "1.0.0",
  "update_manifest_url": "https://github.com/chromeos/iwa-sink/releases/latest/download/update.json",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#24211e",
  "theme_color": "#24211e",
  "isolated_storage": true,
  "display_override": [
    {
      "display": "unframed",
      "url_patterns": [
        {
          "pathname": "/hud.html",
          "search": "*",
          "hash": "*"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/images/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "permissions_policy": {
    "all-screens-capture": ["self"],
    "clipboard-write": ["self"],
    "display-capture": ["self"],
    "cross-origin-isolated": ["self"],
    "direct-sockets": ["self"],
    "direct-sockets-private": ["self"],
    "local-network": ["self"],
    "loopback-network": ["self"],
    "local-network-access": ["self"],
    "controlled-frame": ["self"],
    "sub-apps": ["self"],
    "window-management": ["self"]
  },
  "protocol_handlers": [
    {
      "protocol": "web+cf",
      "url": "/?protocol=%s"
    },
    {
      "protocol": "cf",
      "url": "/?protocol=%s"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "TCP Echo",
      "url": "/?workspace=tcp-terminal",
      "icons": [
        {
          "src": "/images/direct-sockets.png",
          "type": "image/png",
          "sizes": "512x512",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Controlled Frame",
      "url": "/?workspace=controlled-frame-tls",
      "icons": [
        {
          "src": "/images/cf.png",
          "type": "image/png",
          "sizes": "512x512",
          "purpose": "any"
        }
      ]
    }
  ]
}
